def calculate_margin(revenue: float, costs: float) -> tuple[float, float]:
    """Calculates net profit and profit margin percentage."""
    profit = revenue - costs
    margin_pct = (profit/revenue) * 100 if revenue > 0 else 0.0
    return profit, margin_pct

#test function
rev = 125_000.00
expenses = 82_500.00

net, margin = calculate_margin(rev, expenses)
print(f"net Profit: ${net:,.2f}")
print(f"Margin: {margin:.1f}%")
