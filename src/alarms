import numpy as np
import pandas as pd


def alarms_for_array(X: np.ndarray, lcl: np.ndarray, ucl: np.ndarray, w: int):
    """Evaluates same-tag persistence on a single continuous run (no cross-run data).

    Parameters
    ----------
    X : np.ndarray, shape (T, m)
        Sensor tag matrix for a single run.
    lcl : np.ndarray, shape (m,)
        Lower control limits per tag.
    ucl : np.ndarray, shape (m,)
        Upper control limits per tag.
    w : int
        Persistence window size (number of consecutive steps required).

    Returns
    -------
    np.ndarray, shape (T,), dtype bool
        Boolean mask where True indicates an alarm at that time step.
    """
    T, m = X.shape
    if T < w:
        return np.zeros(T, dtype=bool)

    # 1. Pointwise breach mask per tag: shape (T, m)
    breach = (X < lcl) | (X > ucl)

    # 2. Same-tag persistence: check w consecutive steps along axis 0
    # sliding_window_view shape: (T - w + 1, m, w)
    windows = np.lib.stride_tricks.sliding_window_view(breach, window_shape=w, axis=0)

    # Must be True for all w steps on the SAME tag: shape (T - w + 1, m)
    tag_persisted = np.all(windows, axis=-1)

    # 3. Plant alarm triggers if ANY tag satisfies persistence: shape (T - w + 1,)
    valid_alarms = np.any(tag_persisted, axis=1)

    # 4. Strict no-padding alignment: first w - 1 steps cannot satisfy window w
    alarm_mask = np.zeros(T, dtype=bool)
    alarm_mask[w - 1 :] = valid_alarms

    return alarm_mask


def alarms(df: pd.DataFrame,tag_cols: list[str], lcl: np.ndarray,ucl: np.ndarray, w: int, run_col: str = "run_id"):
    """Applies same-tag persistence strictly isolated per run_id."""
    alarm_series = pd.Series(index=df.index, dtype=bool)

    # Process each run independently to prevent cross-run state carryover
    for _, group in df.groupby(run_col, sort=False):
        X = group[tag_cols].to_numpy()
        run_alarms = alarms_for_array(X, lcl, ucl, w)
        alarm_series.loc[group.index] = run_alarms

    return alarm_series
