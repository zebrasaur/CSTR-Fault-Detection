import numpy as np
import math
from integrate import rk4_step


def test_ode(y,t):
    return -0.5 * y

y0 = np.array([100.0])
t0 = 0.0
h = 0.1

y1 = rk4_step(test_ode, y0, t0, h)

y_actual = y0*np.exp(-0.5*(t0 + h))

print(f"Time t = {t0}: y = {y0[0]:.4f}")
print(f"Time t = {t0 + h}: y_numerical= {y1[0]:.4f}")
print(f"Time t = {t0 + h}: y_actual ={y_actual[0]:.4f} ")    
    